    <!-- Card 2: Quick Test -->
    <string name="card_quick_test_title">Teste Rápido: SDR vs HDR</string>
    <string name="card_quick_test_subtitle">Comparação automatizada de 10 segundos em ecrã inteiro</string>
    <string name="test_how_it_works_title">Como funciona o teste:</string>
    <string name="test_how_it_works_text">• 10 segundos em SDR, com transição automática para HDR em ecrã cheio.\n• O ecrã é colocado com brilho no máximo (100%) durante o teste.</string>
    <string name="test_what_to_look_title">O que deves observar no ecrã:</string>
    <string name="test_what_to_look_text">• Fundo Preto Puro: Em ecrãs OLED, o fundo é preto absoluto (píxeis desligados). Em ecrãs LCD, poderás notar um ligeiro brilho cinzento (backlight glow).\n• 6 Degraus Quase-Preto: Observa as 6 barras de cinzento suave (1%, 2%…). Devem ser percetíveis sem clarear o fundo preto ao redor.</string>
    <string name="btn_start_test">▶ Iniciar Teste SDR vs HDR em Ecrã Cheio</string>


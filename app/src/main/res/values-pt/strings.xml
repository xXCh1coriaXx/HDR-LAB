    <!-- Card 2: Quick Test -->
    <string name="card_quick_test_title">Teste Rápido: SDR vs HDR</string>
    <string name="card_quick_test_subtitle">Comparação automatizada de 10 segundos em ecrã inteiro</string>
    <string name="test_how_it_works_title">Como funciona o teste:</string>
    <string name="test_how_it_works_text">• Apresenta SDR durante 10 segundos e depois solicita HDR10/PQ.\n• O ecrã inteiro inicia com brilho máximo da janela; o comportamento do sistema pode variar.</string>
    <string name="test_what_to_look_title">O que deves observar no ecrã:</string>
    <string name="test_what_to_look_text">• Observa o fundo preto e regista qualquer brilho visível.\n• Compara os seis degraus de referência quase-preto e regista quantos distingues. São níveis de sinal codificados, não percentagens de brilho nem medições do ecrã; as condições de observação e o processamento afetam a visibilidade.</string>
    <string name="btn_start_test">▶ Iniciar Teste SDR vs HDR em Ecrã Cheio</string>
    <string name="btn_community_report">📋 Submeter Relatório Comunitário</string>


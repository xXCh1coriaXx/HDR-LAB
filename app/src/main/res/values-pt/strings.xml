    <string name="hud_title_sdr_active">MODO SDR ATIVADO</string>
    <string name="hud_tip_sdr_active">Observa o preto e os seis degraus; regista os visíveis. São referências de sinal.</string>
    <string name="hud_title_hdr_active">HDR10 / PQ SOLICITADO</string>
    <string name="hud_tip_hdr_active">HDR10/PQ solicitado. Regista o preto e os degraus visíveis; isto não confirma saída HDR.</string>


    <!-- Card 2: Quick Test -->
    <string name="card_quick_test_title">Quick Test: SDR vs HDR</string>
    <string name="card_quick_test_subtitle">Automated 10-second fullscreen comparison</string>
    <string name="test_how_it_works_title">How the test works:</string>
    <string name="test_how_it_works_text">• Shows SDR for 10 seconds, then requests HDR10/PQ.\n• Fullscreen starts at maximum window brightness; system behavior may vary.</string>
    <string name="test_what_to_look_title">What to look for on screen:</string>
    <string name="test_what_to_look_text">• Observe the black surround and note any visible glow.\n• Compare the six near-black reference steps and record how many you can distinguish. These are encoded signal levels, not brightness percentages or panel measurements; viewing conditions and processing affect visibility.</string>
    <string name="btn_start_test">▶ Start Fullscreen SDR vs HDR Test</string>
    <string name="btn_community_report">📋 Submit Community Report</string>


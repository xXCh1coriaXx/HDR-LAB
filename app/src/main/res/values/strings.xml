    <!-- Card 2: Quick Test -->
    <string name="card_quick_test_title">Quick Test: SDR vs HDR</string>
    <string name="card_quick_test_subtitle">Automated 10-second fullscreen comparison</string>
    <string name="test_how_it_works_title">How the test works:</string>
    <string name="test_how_it_works_text">• 10 seconds in SDR, with an automatic transition to HDR in fullscreen.\n• Display is set to maximum brightness (100%) during the test.</string>
    <string name="test_what_to_look_title">What to look for on screen:</string>
    <string name="test_what_to_look_text">• True Black Background: On OLED displays, the background is pitch black (pixels off). On LCD screens, you may notice a slight grey glow (backlight glow).\n• 6 Near-Black Steps: Watch the 6 gentle grey bars (1%, 2%…). They should be distinguishable without elevating the surrounding black background.</string>
    <string name="btn_start_test">▶ Start Fullscreen SDR vs HDR Test</string>
    <string name="btn_community_report">📋 Submit Community Report</string>

